#!/bin/bash
# AppRun for 弧迹 (huji) AppImage
# Runs at AppImage launch; sets up environment then execs the Flutter binary.

set -e

# Resolve $APPDIR (set automatically by AppImage runtime)
HERE="$(dirname "$(readlink -f "${0}")")"
export APPDIR="${APPDIR:-$HERE}"

# Prefer bundled libs (Flutter plugins + GPU ORT + CUDA redist) over system.
# usr/bin/lib is where the Flutter linux bundle places .so (RPATH $ORIGIN/lib).
export LD_LIBRARY_PATH="$APPDIR/usr/bin/lib:$APPDIR/usr/lib:$APPDIR/usr/lib/x86_64-linux-gnu:$APPDIR/usr/lib/aarch64-linux-gnu:${LD_LIBRARY_PATH:-}"

# Make bundled ffmpeg findable
export PATH="$APPDIR/usr/bin:$PATH"

# linuxdeploy-plugin-gtk's AppRun hook forces GDK_BACKEND=x11 (a blanket
# workaround for bundled-GTK Wayland crashes). On hybrid-GPU Wayland hosts
# that breaks Flutter's EGL context, dropping media_kit to software video
# rendering. Prefer native Wayland with an X11 fallback instead — Flutter
# GTK apps run fine on Wayland (same as flutter run / dev builds).
export GDK_BACKEND="wayland,x11"

# Launch the Flutter app
exec "$APPDIR/usr/bin/huji" "$@"
